# === Iztack-Finance - Variables de Entorno ===
# Copia este archivo a .env y rellena los valores reales.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sistema_financiero
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/sistema_financiero

# --- Security ---
SECRET_KEY=tu-secret-key-aqui-cambiar-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OpenRouter (LLM) ---
OPENROUTER_API_KEY=sk-or-v1-tu-api-key-de-openrouter
OCR_MODEL=google/gemma-4-26b-a4b-it:free
AGENT_OCR_MODEL=google/gemma-4-26b-a4b-it:free
AGENT_WORKER_MODEL=openai/gpt-oss-20b:free
AGENT_SPECIALIST_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AGENT_DEFAULT_MODEL=openai/gpt-oss-20b:free
LLM_DEFAULT_MODEL=openai/gpt-oss-20b:free

# --- Gemini AI (OCR) - legacy / optional ---
GEMINI_API_KEY=tu-api-key-de-gemini

# --- Telegram Bot ---
# Optional dev override. In production the bot reads the encrypted token from DB.
TELEGRAM_BOT_TOKEN=tu-token-de-telegram-bot
TELEGRAM_CHAT_ID_AUTHORIZED=tu-chat-id

# --- Twilio (WhatsApp) - not currently used ---
# TWILIO_ACCOUNT_SID=tu-account-sid
# TWILIO_AUTH_TOKEN=tu-auth-token
# TWILIO_WHATSAPP_NUMBER=+14155238886

# --- Google APIs (Gmail + Drive) ---
GOOGLE_CLIENT_ID=tu-client-id
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REFRESH_TOKEN=tu-refresh-token
GOOGLE_DRIVE_FOLDER_ID=id-carpeta-principal-drive

# --- Gmail ---
GMAIL_SENDER_EMAIL=noreply@iztack.com

# --- SMTP / Admin alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASSWORD=tu-app-password
SMTP_USE_TLS=true
ADMIN_ALERT_EMAILS=admin@iztack.com,abraham@iztack.com

# --- Redis (cache / task broker if needed) ---
REDIS_URL=redis://localhost:6379/0

# --- Storage Preference ---
STORAGE_BACKEND=drive  # 'drive' o 'icloud'

# --- Printer ---
PRINTER_TYPE=usb  # 'usb' o 'bluetooth'
PRINTER_WIDTH=57  # 57 o 80 (mm)
PRINTER_VENDOR_ID=0x0416
PRINTER_PRODUCT_ID=0x5011
PRINTER_BLUETOOTH_MAC=00:00:00:00:00:00

# --- Server ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # development, staging, production

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,https://finance.iztack.com,https://apifinance.iztack.com,https://admfinance.iztack.com

# --- App ---
APP_NAME=Iztack-Finance
APP_VERSION=1.0.0

# --- Setup wizard crypto ---
# Path to the master key file used to encrypt tenant secrets in the DB.
# In production, mount an existing key file instead of auto-generating one.
SETUP_MASTER_KEY_FILE=/opt/iztack-finance/.setup_key

# --- Frontend build / dev proxy ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
BACKEND_HOST=sf-backend:8000
