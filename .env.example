# === Sistema Financiero - Variables de Entorno ===

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sistema_financiero
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sistema_financiero

# --- Security ---
SECRET_KEY=tu-secret-key-aqui-cambiar-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Gemini AI (OCR) ---
GEMINI_API_KEY=tu-api-key-de-gemini

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=tu-token-de-telegram-bot
TELEGRAM_CHAT_ID_AUTHORIZED=tu-chat-id

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=tu-account-sid
TWILIO_AUTH_TOKEN=tu-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# --- Google APIs (Gmail + Drive) ---
GOOGLE_CLIENT_ID=tu-client-id
GOOGLE_CLIENT_SECRET=tu-client-secret
GOOGLE_REFRESH_TOKEN=tu-refresh-token
GOOGLE_DRIVE_FOLDER_ID=id-carpeta-principal-drive

# --- Gmail ---
GMAIL_SENDER_EMAIL=tu-email@gmail.com

# --- Redis (Celery) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Storage Preference ---
STORAGE_BACKEND=drive  # 'drive' o 'icloud'

# --- Printer ---
PRINTER_TYPE=usb  # 'usb' o 'bluetooth'
PRINTER_WIDTH=57  # 57 o 80 (mm)
PRINTER_VENDOR_ID=0x0416
PRINTER_PRODUCT_ID=0x5011
PRINTER_BLUETOOTH_MAC=00:00:00:00:00:00

# --- Server ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # development, staging, production

# --- App ---
APP_NAME=Sistema Financiero
APP_VERSION=1.0.0